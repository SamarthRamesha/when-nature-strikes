# ---------------------------------------------------------------------------
# When Nature Strikes — ignored files
# Nothing here is project evidence. Data, notebooks, charts and scripts are
# tracked deliberately; see README.md for the repository layout.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.jupyter_cache/

# Power BI / Office temporary lock files
~$*.pbix
~$*.xlsx
~$*.docx
~$*.pptx
*.pbix~
*.tmp

# OS and editor metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
*.swp
*~

# Logs and scratch output
*.log
*.out
scratch/
tmp/

# Secrets — never commit credentials or local environment files
.env
.env.*
!.env.example
secrets/
*.pem
*.key
